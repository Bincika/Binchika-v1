# Binchika environment template. KEEP THIS FILE EMPTY OF REAL VALUES — it is public.
# Put real values in `.env` (local scripts) and `.dev.vars` (wrangler pages dev); both are gitignored.
# Production secrets go into Cloudflare:  npx wrangler pages secret put NAME --project-name binchika
# A pre-commit hook (scripts/hooks/pre-commit) blocks commits that put values in this file.

# --- Cloudflare (deploy + D1 + R2 + Email Routing) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=            # scopes: Pages:Edit, D1:Edit, R2:Edit, Zone:DNS:Edit, Email Routing:Edit (binchika.com)

# --- R2 S3 API (bucket binchika-evidence; only for signed upload URLs and scripts; see docs/R2-WIRING.md) ---
R2_ACCESS_KEY_ID=                # R2 API token: Object Read & Write, binchika-evidence only. Never paste into chat.
R2_SECRET_ACCESS_KEY=            # shown once when the token is created
R2_S3_ENDPOINT=                  # https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=                       # binchika-evidence

# --- Supabase (verifier accounts, auth) — project ref YOUR-PROJECT-REF ---
SUPABASE_URL=
SUPABASE_ANON_KEY=               # publishable key (sb_publishable_…) — safe in the browser
SUPABASE_SERVICE_ROLE_KEY=       # secret key (sb_secret_…) — server-only, never ship to the browser
SUPABASE_ACCESS_TOKEN=           # personal access token (sbp_…) for CLI/migrations

# --- Ingestion ---
INGEST_TOKEN=                    # shared secret for POST /api/reports (bots, pipelines)
REPORTER_HASH_SALT=              # random 32+ chars; salts reporter handle hashes
TELEGRAM_BOT_TOKEN=              # from @BotFather
TELEGRAM_WEBHOOK_SECRET=         # random string; set via setWebhook secret_token

# --- IPFS pinning (free tiers; high-confidence verified tallies only) ---
PINATA_JWT=
STORACHA_KEY=                    # optional second pin for redundancy
STORACHA_PROOF=

# --- Email (Resend, domain binchika.com verified) ---
RESEND_API_KEY=
RESEND_FROM_NOREPLY=Binchika <noreply@binchika.com>     # announcements, verifier notices, account confirmations
RESEND_FROM_ACCOUNTS=Binchika Accounts <accounts@binchika.com>  # manifestos, data requests, party communication
RESEND_FROM_OPS=Binchika Ops <ops@binchika.com>         # maintenance, technical, operational
EMAIL_FORWARD_TO=                # inbox that receives all routed mail

# --- GitHub ledger publishing ---
GITHUB_TOKEN=                    # fine-grained, contents:write on Bincika/Binchika only
